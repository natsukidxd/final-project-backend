{
  "name": "backend",
  "version": "1.0.0",
  "description": "Node.js + TypeScript + Express + Sequelize + PostgreSQL Authentication API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--dns-result-order=ipv4first\" ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc && shx cp src/swagger.yaml dist/swagger.yaml",
    "start": "node dist/server.js",
    "prod": "npm run build && npm start"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "joi": "^18.2.1",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "postgres": "^3.4.9",
    "resend": "^6.12.3",
    "sequelize": "^6.37.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "shx": "^0.4.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
