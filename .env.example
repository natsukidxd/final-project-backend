# Database (using Supabase pooler for stable connections)
DATABASE_URL=postgresql://user:password@host:5432/database

# JWT
JWT_SECRET=

# CORS
CORS_ORIGIN=

# Cookies
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# SMTP (Ethereal - for development)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Server
PORT=4000
NODE_ENV=development