# Database (using Supabase pooler for stable connections)
DATABASE_URL=postgresql://user:password@host:5432/database

# JWT
JWT_SECRET=

# CORS
CORS_ORIGIN=

# Cookies
# Production: COOKIE_SECURE=true, COOKIE_SAMESITE=none (required for cross-site, HTTPS)
# Development: COOKIE_SECURE=false, COOKIE_SAMESITE=lax (works on localhost HTTP)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Resend (for transactional emails)
# Get your API key from https://resend.com/api-keys
# Free plan only sends to your verified email — actual recipient is logged & shown in email body
RESEND_API_KEY=
EMAIL_FROM="Auth API <onboarding@resend.dev>"

# Server
# Production: PORT=4000, NODE_ENV=production
# Development: PORT=4000, NODE_ENV=development
PORT=4000
NODE_ENV=development