# Database (using Supabase pooler for stable connections)
DATABASE_URL=postgresql://user:password@host:5432/database

# JWT
JWT_SECRET=

# CORS
CORS_ORIGIN=

# Cookies
# Production: COOKIE_SECURE=true, COOKIE_SAMESITE=none (required for cross-site, HTTPS)
# Development: COOKIE_SECURE=false, COOKIE_SAMESITE=lax (works on localhost HTTP)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# SMTP (Gmail - for production; use Ethereal fallback if SMTP_USER is empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Auth API <your-gmail@gmail.com>"

# Server
# Production: PORT=4000, NODE_ENV=production
# Development: PORT=4000, NODE_ENV=development
PORT=4000
NODE_ENV=development
